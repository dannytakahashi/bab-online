# BABOnline.xcodeproj is hand-maintained and tracked (project.pbxproj, plus
# xcshareddata/xcschemes once a shared scheme is added). Only its embedded
# workspace is Xcode-generated: it holds the SwiftPM Package.resolved, which
# the repo does not pin today.
*.xcodeproj/project.xcworkspace/

# Xcode user data
xcuserdata/
*.xcworkspace/xcuserdata/

# Build output
build/
DerivedData/

# SPM
.build/
.swiftpm/

# macOS
.DS_Store
