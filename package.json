{
    "name": "multiplayer-card-game",
    "version": "1.0.0",
    "description": "A 4-player online card game using Phaser and Socket.io",
    "main": "server/index.js",
    "scripts": {
        "start": "node server/index.js",
        "dev": "nodemon server/index.js",
        "dev:client": "cd client && vite --port 5173",
        "build": "npm run build:client",
        "build:client": "cd client && vite build",
        "test": "jest",
        "test:client": "vitest run --config client/vite.config.js",
        "test:client:watch": "vitest --config client/vite.config.js",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "tokens": "node scripts/build-tokens.js",
        "tokens:check": "node scripts/build-tokens.js --check",
        "build:avatars": "node scripts/build-avatars.js",
        "build:icons": "node scripts/build-icons.js",
        "sim": "node server/game/bot/sim/simulate.js",
        "ios:fixtures": "node server/game/bot/sim/simulate.js --record-ios iOSClient/BABOnlineTests/Fixtures/events",
        "contract:gen": "node contract/gen.js",
        "contract:check": "node contract/gen.js --check",
        "contract:baseline": "node contract/baseline.js",
        "contract:fixtures": "UPDATE_CONTRACT_FIXTURES=1 jest server/socket/__tests__/contractFixtures.test.js",
        "test:contract": "CHAOS_SEEDS=1500 jest server/socket/__tests__/chaos.test.js server/socket/__tests__/tournamentLifecycle.test.js server/socket/__tests__/contract.test.js",
        "test:race": "BAB_PACING=zero CHAOS_SEEDS=200 jest server/socket/__tests__/chaos.test.js server/socket/__tests__/tournamentLifecycle.test.js server/socket/__tests__/hardening.test.js server/socket/__tests__/pacingBudget.test.js"
    },
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "compression": "^1.8.2",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "joi": "^18.0.2",
        "mongodb": "^6.14.2",
        "sharp": "0.34.5",
        "socket.io": "^4.8.1",
        "uuid": "^9.0.0",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "jsdom": "^24.0.0",
        "nodemon": "^3.1.9",
        "phaser": "3.55.2",
        "socket.io-client": "4.8.1",
        "vite": "^5.4.0",
        "vitest": "^2.0.0"
    },
    "jest": {
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/server",
            "<rootDir>/contract"
        ],
        "testMatch": [
            "**/__tests__/**/*.js",
            "**/*.test.js"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/server/testUtils/fsmGuard.js",
            "<rootDir>/server/testUtils/contractGuard.js",
            "<rootDir>/server/testUtils/pacingReset.js"
        ],
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "server/**/*.js",
            "!server/**/__tests__/**"
        ],
        "verbose": true
    },
    "engines": {
        "node": "24.x"
    },
    "author": "Your Name",
    "license": "MIT"
}
