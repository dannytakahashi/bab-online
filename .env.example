# MongoDB connection string
# Local development: mongodb://localhost:27017/babonline
# Production: Use MongoDB Atlas or similar
MONGO_URI=mongodb://localhost:27017/babonline

# Database the server and the admin scripts use (optional, defaults to babonline).
# A database in MONGO_URI's path is never used for data (the server warns when
# it differs). backup-db.js / restore-db.js read DB_NAME from the shell only.
# DB_NAME=babonline

# Server port (optional, defaults to 3000)
PORT=3000

# Node environment (development, production)
NODE_ENV=development
