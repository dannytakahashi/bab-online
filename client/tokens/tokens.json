{
  "$description": "BAB Online design tokens: the single source for the web client (npm run tokens writes client/styles/tokens.css and client/src/ui/tokens.js) and, later, iOS Theme.swift (roadmap item 29). Platform-neutral on purpose: colors are #RRGGBB or #RRGGBBAA strings, sizes are unitless points (px on the web, pt on iOS), durations are milliseconds, easings are cubic-bezier control points, shadows are structured layers. Keys are camelCase so every generator can use them as identifiers.",
  "version": 1,
  "color": {
    "felt": {
      "edge": "#071d15",
      "deep": "#0b2e22",
      "base": "#0f3d2e",
      "light": "#145a41",
      "rail": "#082419",
      "railHighlight": "#1f6e51"
    },
    "surface": {
      "s0": "#0c1411",
      "s1": "#131d19",
      "s2": "#1b2722",
      "s3": "#25342d"
    },
    "line": {
      "subtle": "#ffffff1f",
      "strong": "#ffffff38"
    },
    "text": {
      "primary": "#f4f7f5",
      "secondary": "#c3cfca",
      "dim": "#93a39c",
      "onLight": "#0c1411",
      "onPrimary": "#04230f"
    },
    "team": {
      "a": "#5aa9ff",
      "b": "#ff7f6e"
    },
    "gold": "#f2c14e",
    "primary": {
      "base": "#3ccf84",
      "hover": "#5bdc99"
    },
    "danger": {
      "text": "#ff7b72",
      "solid": "#c4302b",
      "solidHover": "#a8261f"
    },
    "success": "#4ade80",
    "warning": "#f5b041",
    "scrim": "#000000b8",
    "card": {
      "face": "#ffffff",
      "border": "#b3b3b3",
      "red": "#d91a1a",
      "black": "#1a1a1a",
      "joker": "#800080",
      "back": "#1a4d26",
      "backBorder": "#33803f",
      "backInner": "#266633",
      "backDiamond": "#408c4d",
      "backDiamondStroke": "#4da659",
      "dimTint": "#999999",
      "shadow": "#00000073"
    }
  },
  "font": {
    "ui": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "heavy": 800
    }
  },
  "type": {
    "xs": 12,
    "sm": 14,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "xxl": 32,
    "display": 48
  },
  "space": {
    "unit": 4,
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 20,
    "s6": 24,
    "s8": 32,
    "s10": 40,
    "s12": 48
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "pill": 999
  },
  "elevation": {
    "e1": [
      { "x": 0, "y": 1, "blur": 2, "spread": 0, "color": "#00000059" },
      { "x": 0, "y": 1, "blur": 1, "spread": 0, "color": "#00000033" }
    ],
    "e2": [
      { "x": 0, "y": 4, "blur": 12, "spread": 0, "color": "#00000066" }
    ],
    "e3": [
      { "x": 0, "y": 12, "blur": 32, "spread": 0, "color": "#00000080" }
    ]
  },
  "z": {
    "table": 1,
    "hud": 2,
    "panel": 500,
    "modal": 2000,
    "toast": 9000,
    "transition": 99999,
    "banner": 100000
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 350
    },
    "easing": {
      "emphasized": [0.2, 0.8, 0.2, 1],
      "standard": [0.4, 0, 0.2, 1]
    },
    "stagger": {
      "deal": 35
    },
    "glowPeriod": 1600
  },
  "hitTarget": 44,
  "contrast": [
    { "fg": "text.primary", "bg": ["surface.s0"], "min": 4.5 },
    { "fg": "text.primary", "bg": ["surface.s1"], "min": 4.5 },
    { "fg": "text.primary", "bg": ["surface.s2"], "min": 4.5 },
    { "fg": "text.primary", "bg": ["surface.s3"], "min": 4.5 },
    { "fg": "text.secondary", "bg": ["surface.s1"], "min": 4.5 },
    { "fg": "text.secondary", "bg": ["surface.s2"], "min": 4.5 },
    { "fg": "text.secondary", "bg": ["surface.s3"], "min": 4.5 },
    { "fg": "text.dim", "bg": ["surface.s1"], "min": 4.5 },
    { "fg": "text.dim", "bg": ["surface.s2"], "min": 4.5 },
    { "fg": "text.primary", "bg": ["surface.s2@0.86", "felt.base"], "min": 4.5, "use": "seat plate name over the felt" },
    { "fg": "text.primary", "bg": ["surface.s2@0.86", "felt.light"], "min": 4.5, "use": "seat plate name over the lit felt" },
    { "fg": "text.secondary", "bg": ["surface.s2@0.86", "felt.light"], "min": 4.5, "use": "HSI box" },
    { "fg": "team.a", "bg": ["surface.s1"], "min": 4.5, "use": "log rows and score, team A" },
    { "fg": "team.b", "bg": ["surface.s1"], "min": 4.5, "use": "log rows and score, team B" },
    { "fg": "team.a", "bg": ["surface.s2"], "min": 4.5 },
    { "fg": "team.b", "bg": ["surface.s2"], "min": 4.5 },
    { "fg": "gold", "bg": ["surface.s1"], "min": 4.5, "use": "bid sheet title, TRUMP label" },
    { "fg": "gold", "bg": ["felt.light"], "min": 3, "use": "turn ring, dealer ring (UI glyph)" },
    { "fg": "team.a", "bg": ["felt.light"], "min": 3, "use": "team ring (UI glyph)" },
    { "fg": "team.b", "bg": ["felt.light"], "min": 3, "use": "team ring (UI glyph)" },
    { "fg": "success", "bg": ["surface.s1"], "min": 4.5, "use": "spectator rows, made-bid border" },
    { "fg": "danger.text", "bg": ["surface.s1"], "min": 4.5, "use": "defeat, faults, set border" },
    { "fg": "warning", "bg": ["surface.s1"], "min": 4.5, "use": "connection banner" },
    { "fg": "text.onPrimary", "bg": ["primary.base"], "min": 4.5, "use": "primary button" },
    { "fg": "text.onPrimary", "bg": ["primary.hover"], "min": 4.5 },
    { "fg": "text.primary", "bg": ["danger.solid"], "min": 4.5, "use": "danger button, bore chips" },
    { "fg": "text.primary", "bg": ["danger.solidHover"], "min": 4.5 },
    { "fg": "text.onLight", "bg": ["text.primary"], "min": 4.5, "use": "chat bubble" },
    { "fg": "card.red", "bg": ["card.face"], "min": 4.5, "use": "red card index" },
    { "fg": "card.black", "bg": ["card.face"], "min": 4.5, "use": "black card index" },
    { "fg": "card.joker", "bg": ["card.face"], "min": 4.5, "use": "joker index" },
    { "fg": "text.primary", "bg": ["scrim", "felt.light"], "min": 4.5, "use": "score modal" },
    { "fg": "text.secondary", "bg": ["scrim", "felt.light"], "min": 4.5 },
    { "fg": "text.secondary", "bg": ["surface.s0"], "min": 4.5, "use": "screens: chat wells, inputs (item 18b)" },
    { "fg": "text.dim", "bg": ["surface.s0"], "min": 4.5, "use": "screens: input placeholders, chat timestamps" },
    { "fg": "text.dim", "bg": ["surface.s3"], "min": 4.5, "use": "screens: hovered rows" },
    { "fg": "text.primary", "bg": ["surface.s3"], "min": 4.5, "use": "screens: hovered rows, secondary buttons" },
    { "fg": "primary.base", "bg": ["surface.s1"], "min": 4.5, "use": "screens: brand title, active sort column" },
    { "fg": "primary.base", "bg": ["surface.s2"], "min": 4.5, "use": "screens: stat values" },
    { "fg": "success", "bg": ["surface.s2"], "min": 4.5, "use": "screens: Ready, open seats, winners" },
    { "fg": "danger.text", "bg": ["surface.s2"], "min": 4.5, "use": "screens: Full, losers, lowest score" },
    { "fg": "warning", "bg": ["surface.s2"], "min": 4.5, "use": "screens: biggest win, host, report" },
    { "fg": "team.a", "bg": ["surface.s0"], "min": 4.5, "use": "screens: input focus ring, links" },
    { "fg": "danger.text", "bg": ["danger.solid@0.14", "surface.s1"], "min": 4.5, "use": "profile: danger zone" },
    { "fg": "text.secondary", "bg": ["danger.solid@0.14", "surface.s1"], "min": 4.5, "use": "profile: danger zone copy" },
    { "fg": "team.a", "bg": ["team.a@0.16", "surface.s2"], "min": 4.5, "use": "screens: team A chip" },
    { "fg": "team.b", "bg": ["team.b@0.16", "surface.s2"], "min": 4.5, "use": "screens: team B chip" },
    { "fg": "primary.hover", "bg": ["felt.deep"], "min": 3, "use": "sign-in splash (large italic)" },
    { "fg": "text.primary", "bg": ["surface.s1@0.92", "felt.deep"], "min": 4.5, "use": "sign-in / register card over the page" },
    { "fg": "text.dim", "bg": ["surface.s1@0.92", "felt.deep"], "min": 4.5, "use": "sign-in divider, terms note" }
  ]
}
